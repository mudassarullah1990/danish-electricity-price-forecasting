# ============================================================
# Datasets
# ============================================================
# DVC manages the OPSD dataset.
# DVC generates Git ignore rules for tracked data files.
# Do not ignore the entire /data/ directory.
# Do not add a global *.csv rule.

/datasets/
*.parquet
*.h5
*.hdf5

# ============================================================
# Trained models
# ============================================================
# Model binaries are managed by DVC, not Git.
# Allow Git to track model metadata files.

/models/*
!/models/*.dvc

*.cbm
*.pkl
*.pickle
*.joblib
*.onnx
*.pth
*.pt

# ============================================================
# MLflow experiment outputs
# ============================================================
mlflow.db
mlflow.db-*
mlruns/
mlartifacts/
outputs/
multirun/

# ============================================================
# Logs
# ============================================================
*.log

# ============================================================
# DVC local cache and settings
# ============================================================
.dvc/cache/
.dvc/tmp/
.dvc/config.local

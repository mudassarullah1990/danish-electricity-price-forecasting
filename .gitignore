# ============================================================
# DVC
# ============================================================

# Ignore local DVC cache and configuration.
# Keep .dvc/config and .dvc tracking files in Git.
.dvc/cache/
.dvc/tmp/
.dvc/config.local

# ============================================================
# Raw and processed datasets
# ============================================================

# Dataset binaries must be managed by DVC, not Git.
data/raw/*
data/processed/*

# Allow DVC metadata and directory placeholders.
!data/raw/*.dvc
!data/processed/*.dvc
!data/raw/.gitkeep
!data/processed/.gitkeep

# ============================================================
# Model training outputs
# ============================================================

# Ignore generated outputs by default.
outputs/*

# Allow model directory and DVC tracking files.
!outputs/models/
outputs/models/*
!outputs/models/*.dvc

# ============================================================
# CatBoost
# ============================================================

catboost_info/

# ============================================================
# MLflow
# ============================================================

mlruns/
mlartifacts/
mlflow.db
mlflow.db-*
*.sqlite
*.sqlite3

# ============================================================
# Logs and temporary files
# ============================================================

*.log
logs/
tmp/
temp/
.cache/

# ============================================================
# Local backup and miscellaneous files
# ============================================================

*.bak
*.backup
*.tmp

# ============================================================
# IMPORTANT: Files that must remain version-controlled
# ============================================================

# pyproject.toml
# uv.lock
# README.md
# .pre-commit-config.yaml
# .github/workflows/ci.yml
# configs/
# src/
# tests/
# .dvc/config
# *.dvc
